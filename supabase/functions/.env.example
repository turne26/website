# Secrets for the Turne `api` Edge Function.
#
#   1. Copy this file to supabase/functions/.env (git ignores it) and fill in the values.
#   2. Upload them to Supabase:  supabase secrets set --env-file supabase/functions/.env
#      (or paste them in the dashboard: Edge Functions -> Secrets)
#   3. Re-run step 2 whenever you change a value. No redeploy needed.
#
# Leave a line empty to use the default. Don't add SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY:
# Supabase provides those to the function itself and rejects secrets starting with SUPABASE_.

# ---- OTP (Message Central VerifyNow) ------------------------------------------------------
# "test" = no message is sent and the code is always 123456 (anyone can join with any number).
# "messagecentral" = send real codes through Message Central. Switch to this before launch.
OTP_MODE=test

# From the Message Central console (messagecentral.com -> VerifyNow). Looks like C-1234ABCD5678.
MC_CUSTOMER_ID=
# Auth Token shown in the Message Central console. Paste it as is, on one line, no quotes.
MC_AUTH_TOKEN=
# Your Message Central account password, as is (the function base64-encodes it). Optional if
# MC_AUTH_TOKEN is set, but recommended: it lets the function get a new token when that one expires.
MC_PASSWORD=
# Channel the code goes out on: SMS (what Turne uses; the site copy says SMS) or WHATSAPP.
MC_FLOW=SMS

# Random secret used to hash test-mode codes. Generate one with:  openssl rand -hex 32
OTP_PEPPER=

# ---- Site rules ---------------------------------------------------------------------------
# Lifetime Premium spots (must match premiumLimit in src/assets/js/config.js).
PREMIUM_LIMIT=10000
# Minimum age to join (must match minAge in config.js and the Terms).
MIN_AGE=13
# Launch moment for the countdown, ISO 8601 with offset. Empty = use launchAt from config.js.
LAUNCH_AT=

# ---- CORS ---------------------------------------------------------------------------------
# Extra origins allowed to call the API, comma-separated. Already allowed:
# https://turne.in, https://www.turne.in, any *.vercel.app, and localhost.
ALLOWED_ORIGINS=
