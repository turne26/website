# Secrets for the Turne `api` Edge Function.
#
#   1. Copy this file to supabase/functions/.env (git ignores it) and fill in the values.
#   2. Upload them to Supabase:  supabase secrets set --env-file supabase/functions/.env
#      (or paste them in the dashboard: Edge Functions -> Secrets)
#   3. Re-run step 2 whenever you change a value. No redeploy needed.
#
# Leave a line empty to use the default. Don't add SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY:
# Supabase provides those to the function itself and rejects secrets starting with SUPABASE_.

# ---- OTP (WhatsApp, Meta Cloud API) -------------------------------------------------------
# "test" = no message is sent and the code is always 123456 (anyone can join with any number).
# "whatsapp" = send real codes on WhatsApp. Switch to this before launch.
OTP_MODE=test

# Permanent access token of a System User (business.facebook.com -> Business Settings -> Users
# -> System users -> Generate token) with whatsapp_business_messaging and
# whatsapp_business_management. Don't use the 24-hour temporary token from API Setup in production.
WA_ACCESS_TOKEN=
# "Phone number ID" (not the phone number) from developers.facebook.com -> your app ->
# WhatsApp -> API Setup. A long number like 123456789012345.
WA_PHONE_NUMBER_ID=
# Name and language of your APPROVED Authentication template (WhatsApp Manager -> Message templates).
WA_TEMPLATE=turne_otp
WA_TEMPLATE_LANG=en
# Webhook (Meta app -> WhatsApp -> Configuration -> Webhook):
#   Callback URL: https://<project-ref>.supabase.co/functions/v1/api/whatsapp/webhook
#   Verify token: the WA_VERIFY_TOKEN below (any random string, e.g. openssl rand -hex 24)
WA_VERIFY_TOKEN=
# App secret from App settings -> Basic -> App secret (Show). Used to check webhook signatures.
WA_APP_SECRET=
# Graph API version. Leave empty for the default.
WA_GRAPH_VERSION=

# Random secret mixed into stored code hashes. Set it once and keep it. Generate one with:  openssl rand -hex 32
OTP_PEPPER=

# ---- Site rules ---------------------------------------------------------------------------
# 2-Year Premium spots (must match premiumLimit in lib/config.ts).
PREMIUM_LIMIT=10000
# Minimum age to join (must match minAge in lib/config.ts and the Terms).
MIN_AGE=13
# Launch moment for the countdown, ISO 8601 with offset. Empty = use launchAt from lib/config.ts.
LAUNCH_AT=

# ---- CORS ---------------------------------------------------------------------------------
# Extra origins allowed to call the API, comma-separated. Already allowed:
# https://turne.in, https://www.turne.in, any *.vercel.app, and localhost.
ALLOWED_ORIGINS=
